{
  "name": "axolotl-arena",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces",
    "copy-circuits": "mkdir -p packages/frontend/public/circuits && cp circuits/target/prove_hand.json circuits/target/game_move.json circuits/target/aggregate_game.json packages/frontend/public/circuits/",
    "copy-contracts": "mkdir -p packages/frontend/public/contracts && cp packages/contracts/target/triple_triad_nft-TripleTriadNFT.json packages/contracts/target/triple_triad_game-TripleTriadGame.json packages/frontend/public/contracts/",
    "build": "npm run copy-circuits && npm run copy-contracts && npm run build --workspaces"
  },
  "dependencies": {
    "@azguardwallet/aztec-wallet": "^4.1.0-rc.4",
    "@aztec/aztec.js": "4.1.0",
    "@aztec/bb.js": "4.1.0",
    "@aztec/constants": "4.1.0",
    "@aztec/foundation": "4.1.0",
    "@aztec/noir-contracts.js": "4.1.0",
    "@aztec/stdlib": "4.1.0",
    "@aztec/wallets": "4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "fake-indexeddb": "^6.2.5",
    "openai": "^6.25.0",
    "sharp": "^0.34.5"
  }
}
