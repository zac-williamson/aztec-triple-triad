{
  "name": "axolotl-arena",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces",
    "test:all": "bash scripts/test-all.sh",
    "copy-circuits": "mkdir -p packages/frontend/public/circuits && cp circuits/target/prove_hand.json circuits/target/game_move.json circuits/target/aggregate_game.json circuits/target/dummy_move.json circuits/target/dummy_hand.json packages/frontend/public/circuits/",
    "copy-contracts": "mkdir -p packages/frontend/public/contracts && cp packages/contracts/target/triple_triad_nft-TripleTriadNFT.json packages/contracts/target/triple_triad_game-TripleTriadGame.json packages/contracts/target/arena_token-ArenaToken.json packages/frontend/public/contracts/",
    "build": "npm run copy-circuits && npm run copy-contracts && npm run build --workspaces"
  },
  "dependencies": {
    "@aztec/aztec.js": "4.2.0-aztecnr-rc.2",
    "@aztec/bb.js": "4.2.0-aztecnr-rc.2",
    "@aztec/constants": "4.2.0-aztecnr-rc.2",
    "@aztec/foundation": "4.2.0-aztecnr-rc.2",
    "@aztec/noir-contracts.js": "4.2.0-aztecnr-rc.2",
    "@aztec/stdlib": "4.2.0-aztecnr-rc.2",
    "@aztec/wallets": "4.2.0-aztecnr-rc.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "fake-indexeddb": "^6.2.5",
    "openai": "^6.25.0",
    "sharp": "^0.34.5"
  }
}
