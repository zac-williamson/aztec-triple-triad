{
  "name": "@axolotl-arena/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:testnet": "vite --mode testnet",
    "dev:devnet": "vite --mode devnet",
    "build": "vite build",
    "build:testnet": "vite build --mode testnet",
    "build:devnet": "vite build --mode devnet",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "copy-circuits": "mkdir -p public/circuits && cp ../../circuits/target/prove_hand.json ../../circuits/target/game_move.json ../../circuits/target/dummy_move.json public/circuits/",
    "copy-contracts": "mkdir -p public/contracts && cp ../../packages/contracts/target/triple_triad_nft-TripleTriadNFT.json ../../packages/contracts/target/triple_triad_game-TripleTriadGame.json ../../packages/contracts/target/arena_token-ArenaToken.json public/contracts/"
  },
  "dependencies": {
    "@axolotl-arena/game-logic": "file:../game-logic",
    "@aztec/accounts": "4.3.1",
    "@aztec/aztec.js": "4.3.1",
    "@aztec/bb.js": "4.3.1",
    "@aztec/constants": "4.3.1",
    "@aztec/foundation": "4.3.1",
    "@aztec/noir-contracts.js": "4.3.1",
    "@aztec/stdlib": "4.3.1",
    "@aztec/wallets": "4.3.1",
    "@aztec/wallet-sdk": "4.3.1",
    "@noir-lang/noir_js": "1.0.0-beta.21",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@testing-library/dom": "^10.4.1",
    "postprocessing": "^6.38.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^3.0.0"
  }
}
