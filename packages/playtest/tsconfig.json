{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  // scripts/ was missing here, so `tsc --noEmit` reported success on
// files it had never opened — an undefined variable shipped to a
// production run twice behind a green typecheck.
  "include": ["src", "tests", "scripts", "*.ts"]
}
