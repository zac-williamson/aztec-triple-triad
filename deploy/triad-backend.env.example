# Environment file for the triad-backend systemd unit.
# Install at /etc/triad-backend.env, chmod 600, chown root:root.
# Do NOT commit the real file to git.

NODE_ENV=production

# Where the backend listens. Must match Nginx upstream in deploy/nginx-triad.conf.
WS_PORT=5174

# Redis running on the same box. If you move Redis elsewhere, swap for
# redis://user:pass@host:port.
REDIS_URL=redis://localhost:6379

# Comma-separated list of origins the backend will accept for both HTTP
# CORS and WebSocket upgrades. Must include the Vercel production domain
# and any preview domains you want to reach the backend from.
ALLOWED_ORIGINS=https://play.YOURDOMAIN.com
