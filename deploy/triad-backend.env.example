# Environment file for the triad-backend systemd unit.
# Install at /etc/triad-backend.env, chmod 600, chown root:root.
# Do NOT commit the real file to git.

NODE_ENV=production

# Where the backend listens. Must match Nginx upstream in deploy/nginx-triad.conf.
WS_PORT=5174

# Redis running on the same box. If you move Redis elsewhere, swap for
# redis://user:pass@host:port.
REDIS_URL=redis://localhost:6379

# Comma-separated list of origins the backend will accept for both HTTP
# CORS and WebSocket upgrades. Must include the Vercel production domain
# and any preview domains you want to reach the backend from.
ALLOWED_ORIGINS=https://play.YOURDOMAIN.com

# ---------------------------------------------------------------------------
# Fee Juice faucet (item I, Option B). OPTIONAL — leave FAUCET_ENABLED unset to
# run the relay exactly as before (POST /faucet then 404s, zero Aztec surface).
# When enabled, POST /faucet { l2Address } bridges Fee Juice from the Sepolia
# treasury and returns a consumable claim. The treasury key is SERVER-ONLY and
# is never sent to the browser.
#
# Prereqs the systemd unit needs when this is on (see deploy/DEPLOY.md §Faucet):
#   - FEE_JUICE_BRIDGE_PATH must point at COMPILED JS (prod runs plain node, and
#     scripts/lib/feeJuiceBridge.ts is TS-only — see DEPLOY.md for the build step).
#   - The unit's ProtectHome/ReadWritePaths must allow reading the treasury key
#     and writing the claim store (commented lines in triad-backend.service).
# ---------------------------------------------------------------------------
# FAUCET_ENABLED=true
# AZTEC_NODE_URL=https://rpc.testnet.aztec-labs.com
# FAUCET_L1_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY   # or set TESTNET_L1_RPC_URL
# TREASURY_L1_KEY_FILE=/home/ubuntu/.aztec-triad-private/treasury-l1-key.txt  # chmod 600; or TREASURY_L1_KEY=0x...
# FEE_JUICE_BRIDGE_PATH=/home/ubuntu/axolotl-arena-server/scripts/lib/dist/feeJuiceBridge.js
# FEE_JUICE_CLAIMS_FILE=/home/ubuntu/.aztec-triad-private/fee-juice-claims.json
# FAUCET_IP_DAILY_LIMIT=5
# FAUCET_GLOBAL_DAILY_LIMIT=200
