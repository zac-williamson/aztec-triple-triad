# Environment file for the triad-bot systemd unit.
# Install at /etc/triad-bot.env, chmod 600, chown root:root.
# Do NOT commit the real file to git.

NODE_ENV=production

# Must match the relay's ARENA_BOT_TOKEN exactly. Without it the relay refuses
# the bot's registration, and an unregistered bot is treated as an ordinary
# player — which means it could be matched against another bot.
ARENA_BOT_TOKEN=CHANGE_ME

# Relay. Same box, so localhost; the bot polls /queue over HTTP and plays over WS.
ARENA_BOT_WS_URL=ws://localhost:5174
ARENA_BOT_HTTP_URL=http://localhost:5174

# Chain mode: the bot commits REAL cards and settles on-chain. Without this it
# plays but wagers nothing.
ARENA_BOT_CHAIN=1
AZTEC_PXE_URL=https://v5.testnet.rpc.aztec-labs.com

# Contract addresses — must match what the frontend is pointed at, or the bot
# will be playing a different game than the players.
VITE_NFT_CONTRACT_ADDRESS=0x...
VITE_GAME_CONTRACT_ADDRESS=0x...
VITE_TOKEN_CONTRACT_ADDRESS=0x...

# Which provisioned identity to run. One process per identity — the PXE binds
# one wallet per process — so a pool is N units, each with its own index and
# health port.
ARENA_BOT_INDEX=0
ARENA_BOT_HEALTH_PORT=5175

# Proving threads. In Node there is no navigator.hardwareConcurrency, so the
# default is 4 regardless of the machine — set this to the real core count (or
# fewer) so the bot does not starve the relay it shares a box with.
TRIAD_PROOF_THREADS=2

# How long a player waits before the bot offers itself.
ARENA_BOT_JOIN_THRESHOLD_MS=30000

# The public node rate-limits (HTTP 429) under ordinary load. These are the
# defaults; raise the attempt budget if the node is busier than usual.
# ARENA_BOT_RETRY_ATTEMPTS=9
# ARENA_BOT_IMPORT_PACE_MS=250
