[Unit]
Description=Axolotl Arena WebSocket backend
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=ubuntu
# __REPO_DIR__ is substituted by the provision script (sed) with the actual
# clone dir ($HOME/axolotl-arena-server by default). Do not hardcode a repo
# name here — the clone target is parameterized via $REPO_DIR.
WorkingDirectory=__REPO_DIR__/packages/backend

# Environment file holds REDIS_URL, WS_PORT, ALLOWED_ORIGINS, NODE_ENV.
# See deploy/triad-backend.env.example for the template.
EnvironmentFile=/etc/triad-backend.env

# Runs the compiled JS produced by `npm run build --workspace=@axolotl-arena/backend`.
# We use plain node (not tsx) because:
#   1. tsx is not in any package.json — it's only available via `npx tsx` in dev
#      scripts, which tries to fetch the package at runtime.
#   2. With ProtectHome=read-only, npm's cache in ~/.npm is read-only, so npx
#      cannot write there and the service crashes on start.
# The deploy/update-backend.sh script rebuilds before restarting.
ExecStart=/usr/bin/node dist/server.js

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=triad-backend

# Basic hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

# --- Fee Juice faucet (item I) — uncomment ONLY when FAUCET_ENABLED=true ---
# The faucet reads the treasury key and writes the claim store under the user's
# home, which ProtectHome=read-only otherwise blocks. Grant write access to just
# the private dir (keeps the rest of $HOME read-only). Adjust the path if you set
# FEE_JUICE_CLAIMS_FILE / TREASURY_L1_KEY_FILE elsewhere.
# ReadWritePaths=/home/ubuntu/.aztec-triad-private

[Install]
WantedBy=multi-user.target
